 <marmarek@invisiblethingslab.com>
Date: Wed, 6 Aug 2025 12:48:21 +0200
Subject: [PATCH] DEBUG S3

---
 xen/arch/x86/acpi/cpu_idle.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/xen/arch/x86/acpi/cpu_idle.c b/xen/arch/x86/acpi/cpu_idle.c
index 3d19d9980b7c..62191c689634 100644
--- a/xen/arch/x86/acpi/cpu_idle.c
+++ b/xen/arch/x86/acpi/cpu_idle.c
@@ -463,6 +463,7 @@ void mwait_idle_with_hints(unsigned int eax, unsigned int ecx)
     struct cpu_info *info = get_cpu_info();
     irq_cpustat_t *stat = &irq_stat[cpu];
     const unsigned int *this_softirq_pending = &stat->__softirq_pending;
+    s_time_t expires = per_cpu(timer_deadline, cpu);
 
     /*
      * Heuristic: if we're definitely not going to idle, bail early as the
@@ -475,6 +476,9 @@ void mwait_idle_with_hints(unsigned int eax, unsigned int ecx)
     alternative_io("movb $0, %[in_mwait]",
                    "", X86_BUG_MONITOR,
                    [in_mwait] "=m" (stat->in_mwait));
+
+    if ( expires <= NOW() && expires > 0 )
+        raise_softirq(TIMER_SOFTIRQ);
 }
 
 static void acpi_processor_ffh_cstate_enter(struct acpi_processor_cx *cx)
